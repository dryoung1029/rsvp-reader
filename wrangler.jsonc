{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rafas",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/share"]
  },
  // Create with: npx wrangler kv namespace create INBOX  (then paste the id here)
  "kv_namespaces": [
    { "binding": "INBOX", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    // Address set up in Cloudflare Email Routing to send to this Worker (shown on the Help page).
    "INBOX_EMAIL": "read@rafas.app"
  },
  // Secrets (not stored in this file):
  //   npx wrangler secret put INBOX_TOKEN       long random string; also entered in the app
  //   npx wrangler secret put ALLOWED_SENDERS   comma-separated addresses allowed to email documents in
  "routes": [
    { "pattern": "rafas.app", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
